#!/usr/bin/env python3
"""Deterministic governance checks for a repository generated from ai-meta-repo-template.

Template-owned: generated by Copier and changed only through `copier update`.
Standard library only; runs on Windows, Linux, CI, and hosted sessions without network.

Usage:
  python scripts/check_governance.py                      structure, naming, content checks
  python scripts/check_governance.py --branch B --pr-title T   also check branch name and PR title
  python scripts/check_governance.py --meta-only --branch B --pr-title T
  python scripts/check_governance.py --drift              also compare template-owned content with a
                                                          fresh render (needs Copier and the template)
Exit status: 0 = no errors (warnings allowed), 1 = errors.
"""
{%- from 'includes/governance/manifest.jinja' import common_head, autonomy, common_body, extensions, conditional, common_tail %}

# --- Rendered from the template (copier.yml and includes/governance/manifest.jinja) ---
TEMPLATE_REPO = {{ template_repo | tojson }}
DOMAINS = {{ domains | tojson }}
COMMIT_TYPES = {{ commit_types | tojson }}
PROFILES = ["assisted", "agentic", "multi-agent"]
QUESTIONS = ["project_id", "purpose", "scope", "profile", "visibility", "owner", "copyright_holder",
             "copyright_year", "efficiency_routing", "extra_types", "sensitive_data", "tracked_content"]
SECTIONS_HEAD = {{ common_head | tojson }}
SECTIONS_AUTONOMY = {{ autonomy | tojson }}
SECTIONS_BODY = {{ common_body | tojson }}
SECTIONS_EXTENSIONS = {{ extensions | tojson }}
SECTIONS_CONDITIONAL = {{ conditional | tojson }}
SECTIONS_TAIL = {{ common_tail | tojson }}
LAYER_CODES = {"common": "cmn", "assisted": "ast", "agentic": "agt", "multi-agent": "mag"}
{% raw %}
import argparse
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

AGENTS_MAX_LINES = 200        # review threshold (warning)
AGENTS_MAX_BYTES = 32 * 1024  # Codex default project_doc_max_bytes (error)
PLACEHOLDERS = ["{{", "{%", "<project-id>", "<owner>", "<module-repo>"]
SKIP_DIRS = {".git", "data", "node_modules", ".venv", "venv", "__pycache__"}
TEMPLATE_CONTROLLED = ["CLAUDE.md", ".gitattributes", "LICENSE", "scripts/check_governance.py",
                       ".github/workflows/governance.yml", ".pre-commit-config.yaml"]
TEMPLATE_CONTROLLED_DIRS = ["docs/governance"]
MARKER_RE = re.compile(r"<!-- (template-owned id=([a-z-]+)|project-owned[^>]*) -->")


class Report:
    def __init__(self):
        self.errors = []
        self.warnings = []

    def error(self, msg):
        self.errors.append(msg)

    def warn(self, msg):
        self.warnings.append(msg)


def section_id(path):
    layer, name = path.split("/")
    return LAYER_CODES[layer] + "-" + name


def expected_sections(profile, private, efficiency_routing):
    flags = {"private": private, "efficiency_routing": efficiency_routing}
    paths = SECTIONS_HEAD + [SECTIONS_AUTONOMY[profile]] + SECTIONS_BODY + SECTIONS_EXTENSIONS[profile]
    paths += [p for p, flag in SECTIONS_CONDITIONAL if flags[flag]]
    paths += SECTIONS_TAIL
    return [section_id(p) for p in paths]


def read_text(path):
    return path.read_bytes().decode("utf-8", errors="replace").replace("\r\n", "\n")


# --- Answers file -----------------------------------------------------------

def parse_answers(text):
    """Parse the flat answers file Copier writes (top-level scalar keys only)."""
    raw = {}
    key = None
    for line in text.split("\n"):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if line[0] in " \t":
            if key is not None:
                raw[key] += " " + line.strip()
            continue
        match = re.match(r"^([A-Za-z_][A-Za-z0-9_]*):\s?(.*)$", line)
        if not match:
            raise ValueError("unexpected line: " + line)
        key = match.group(1)
        raw[key] = match.group(2).strip()
    return {k: _scalar(v) for k, v in raw.items()}


def _scalar(value):
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
        inner = value[1:-1]
        return inner.replace("''", "'") if value[0] == "'" else inner.replace('\\"', '"')
    if value in ("true", "false"):
        return value == "true"
    if re.fullmatch(r"-?\d+", value):
        return int(value)
    return value


# --- Naming -----------------------------------------------------------------

def project_id_error(project_id):
    """Mirror of the project_id validator in copier.yml (tests keep them equal)."""
    segs = project_id.split("-")
    if not re.fullmatch(r"[a-z0-9]+(-[a-z0-9]+)+", project_id):
        return "use lowercase letters, digits, and single hyphens only"
    if segs[0] != "ai":
        return "a repository Project ID starts with the backing prefix ai-"
    if segs[1] in ("ai", "hm"):
        return "use exactly one backing prefix"
    if "private" in segs[:-1]:
        return "the -private visibility suffix must be the final segment"
    if any(re.fullmatch(r"v[0-9]+", s) for s in segs):
        return "do not put version numbers in a Project ID"
    body = segs[1:-1] if segs[-1] == "private" else segs[1:]
    if len(body) < 1:
        return "add a project segment after the prefix"
    if segs[1] in DOMAINS and len(body) < 2:
        return "add a project segment after the domain"
    return None


def allowed_types(answers):
    extra = answers.get("extra_types") or ""
    return COMMIT_TYPES + [t for t in str(extra).split(",") if t]


def check_branch(branch, types, rep):
    if not branch or branch == "main":
        return
    if not re.fullmatch(r"(%s)/[a-z0-9][a-z0-9._-]*" % "|".join(types), branch):
        rep.error("branch '%s' does not match <type>/<short-description> with types %s" % (branch, ", ".join(types)))


def check_pr_title(title, types, rep):
    if not title:
        return
    if not re.fullmatch(r"(%s)(\([a-z0-9._/-]+\))?!?: \S.*" % "|".join(types), title):
        rep.error("pull request title '%s' is not a Conventional Commit: type(scope): summary" % title)


# --- Content helpers --------------------------------------------------------

def walk_files(root):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS)
        for name in sorted(filenames):
            yield Path(dirpath) / name


def outside_fences(text):
    """Yield (line_number, line) for lines outside fenced code blocks."""
    fence = None
    for number, line in enumerate(text.split("\n"), 1):
        stripped = line.lstrip()
        if fence is None and (stripped.startswith("```") or stripped.startswith("~~~")):
            fence = stripped[:3]
            continue
        if fence is not None:
            if stripped.startswith(fence):
                fence = None
            continue
        yield number, line


def strip_inline_code(line):
    return re.sub(r"`[^`]*`", "", line)


def agents_sections(text):
    """Return [(kind, id_or_None, body)] in document order."""
    marks = list(MARKER_RE.finditer(text))
    sections = []
    for i, mark in enumerate(marks):
        line_start = text.rfind("\n", 0, mark.start()) + 1
        next_start = text.rfind("\n", 0, marks[i + 1].start()) + 1 if i + 1 < len(marks) else len(text)
        kind = "template" if mark.group(1).startswith("template-owned") else "project"
        sections.append((kind, mark.group(2), text[line_start:next_start]))
    return sections


# --- Checks -----------------------------------------------------------------

def check_answers(root, rep):
    path = root / ".copier-answers.yml"
    if not path.is_file():
        rep.error(".copier-answers.yml is missing; this repository cannot be updated by Copier")
        return None
    try:
        answers = parse_answers(read_text(path))
    except ValueError as exc:
        rep.error(".copier-answers.yml is not valid: %s (never edit it by hand)" % exc)
        return None
    for key in ("_commit", "_src_path", "project_id", "profile", "visibility", "owner"):
        if key not in answers:
            rep.error(".copier-answers.yml lacks '%s' (never edit it by hand)" % key)
    unknown = sorted(k for k in answers if not k.startswith("_") and k not in QUESTIONS)
    if unknown:
        rep.error(".copier-answers.yml has unknown keys: %s" % ", ".join(unknown))
    if answers.get("profile") not in PROFILES:
        rep.error("profile '%s' is not one of %s" % (answers.get("profile"), ", ".join(PROFILES)))
        return None
    commit = str(answers.get("_commit", ""))
    if commit and not re.fullmatch(r"v\d+\.\d+\.\d+", commit):
        rep.warn("template version '%s' is not a release tag; update to a tagged release" % commit)
    return answers


def check_identity(root, answers, rep):
    project_id = str(answers.get("project_id", ""))
    problem = project_id_error(project_id)
    if problem:
        rep.error("Project ID '%s': %s" % (project_id, problem))
    github_repo = os.environ.get("GITHUB_REPOSITORY", "")
    if github_repo:
        if github_repo.split("/")[-1] != project_id:
            rep.error("repository name '%s' differs from Project ID '%s'" % (github_repo.split("/")[-1], project_id))
    elif root.resolve().name != project_id:
        rep.warn("local folder '%s' differs from Project ID '%s'" % (root.resolve().name, project_id))
    private = project_id.endswith("-private")
    if private and answers.get("visibility") != "private":
        rep.error("a -private Project ID requires visibility 'private'")
    if private:
        gitignore = root / ".gitignore"
        lines = read_text(gitignore).split("\n") if gitignore.is_file() else []
        if "data/" not in [l.strip() for l in lines]:
            rep.error("-private project: 'data/' must be listed in .gitignore")
    return private


def check_files(root, profile, rep):
    required = ["AGENTS.md", "CLAUDE.md", "LICENSE", "README.md", ".gitignore", ".gitattributes",
                ".github/pull_request_template.md", ".github/workflows/governance.yml",
                "scripts/check_governance.py", "docs/decisions/README.md"]
    forbidden = []
    agentic_doc = "docs/governance/agentic-operations.md"
    multi_doc = "docs/governance/multi-agent-operations.md"
    if profile == "assisted":
        forbidden += [agentic_doc, multi_doc]
    elif profile == "agentic":
        required.append(agentic_doc)
        forbidden.append(multi_doc)
    else:
        required += [agentic_doc, multi_doc]
    for rel in required:
        if not (root / rel).is_file():
            rep.error("required file missing for the %s profile: %s" % (profile, rel))
    for rel in forbidden:
        if (root / rel).exists():
            rep.error("file belongs to another profile: %s (run the profile change procedure)" % rel)
    if profile != "assisted" and not (root / "docs/agent/state.md").is_file():
        rep.warn("docs/agent/state.md does not exist yet; create it before the first delegation "
                 "(format: %s)" % agentic_doc)
    claude = root / "CLAUDE.md"
    if claude.is_file() and read_text(claude).strip() != "@AGENTS.md":
        rep.error("CLAUDE.md must contain only '@AGENTS.md'")


def check_agents(root, profile, private, efficiency_routing, rep):
    path = root / "AGENTS.md"
    if not path.is_file():
        return
    data = path.read_bytes()
    text = read_text(path)
    if len(data) > AGENTS_MAX_BYTES:
        rep.error("AGENTS.md is %d bytes; the limit is %d" % (len(data), AGENTS_MAX_BYTES))
    line_count = text.count("\n")
    if line_count > AGENTS_MAX_LINES:
        rep.warn("AGENTS.md has %d lines; review above %d" % (line_count, AGENTS_MAX_LINES))
    sections = agents_sections(text)
    template_ids = [sid for kind, sid, _ in sections if kind == "template"]
    expected = expected_sections(profile, private, efficiency_routing)
    if template_ids != expected:
        missing = [s for s in expected if s not in template_ids]
        extra = [s for s in template_ids if s not in expected]
        detail = []
        if missing:
            detail.append("missing " + ", ".join(missing))
        if extra:
            detail.append("unexpected " + ", ".join(extra))
        if not detail:
            detail.append("out of order")
        rep.error("AGENTS.md template sections do not match the %s profile: %s" % (profile, "; ".join(detail)))
    if len(template_ids) != len(set(template_ids)):
        rep.error("AGENTS.md repeats a template section")
    kinds = [kind for kind, _, _ in sections]
    if kinds.count("project") != 1 or (kinds and kinds[-1] != "project"):
        rep.error("AGENTS.md must end with exactly one project-owned section")
    seen = {}
    for number, line in outside_fences(text):
        match = re.match(r"^\s*(?:[-*]|\d+\.)\s+(.*)$", line)
        if not match or len(match.group(1).strip()) < 25:
            continue
        item = match.group(1).strip()
        if item in seen:
            rep.error("AGENTS.md line %d repeats line %d: %s" % (number, seen[item], item[:60]))
        else:
            seen[item] = number


def check_content(root, rep):
    for path in walk_files(root):
        rel = path.relative_to(root).as_posix()
        if path.suffix in (".rej", ".orig"):
            rep.error("unresolved update leftover: %s" % rel)
            continue
        try:
            text = path.read_bytes().decode("utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        text = text.replace("\r\n", "\n")
        for number, line in enumerate(text.split("\n"), 1):
            if line.startswith("<<<<<<< ") or line.startswith(">>>>>>> ") or line in ("<<<<<<<", ">>>>>>>"):
                rep.error("merge conflict marker in %s:%d" % (rel, number))
        if path.suffix != ".md":
            continue
        for number, line in outside_fences(text):
            plain = strip_inline_code(line)
            for token in PLACEHOLDERS:
                if token in plain:
                    rep.error("unresolved placeholder '%s' in %s:%d" % (token, rel, number))
            for target in re.findall(r"\]\(([^)\s]+)\)", plain):
                if re.match(r"^[a-z][a-z0-9+.-]*:", target) or target.startswith("#"):
                    continue
                local = target.split("#")[0]
                if local and not (path.parent / local).exists():
                    rep.error("broken link in %s:%d: %s" % (rel, number, target))


def compare_with_render(root, rendered, rep):
    """Compare template-owned content of root with a fresh render of the same answers."""
    def norm(p):
        return read_text(p) if p.is_file() else None

    paths = list(TEMPLATE_CONTROLLED)
    for d in TEMPLATE_CONTROLLED_DIRS:
        for base in (root, rendered):
            if (base / d).is_dir():
                paths += sorted(p.relative_to(base).as_posix() for p in (base / d).rglob("*") if p.is_file())
    for rel in sorted(set(paths)):
        mine, theirs = norm(root / rel), norm(rendered / rel)
        if mine != theirs:
            rep.error("template-controlled file differs from the template: %s" % rel)
    mine = {sid: body for kind, sid, body in agents_sections(norm(root / "AGENTS.md") or "") if kind == "template"}
    theirs = {sid: body for kind, sid, body in agents_sections(norm(rendered / "AGENTS.md") or "") if kind == "template"}
    for sid in sorted(set(mine) | set(theirs)):
        if mine.get(sid) != theirs.get(sid):
            rep.error("AGENTS.md template-owned section differs from the template: %s" % sid)
    ignore_rendered = (norm(rendered / ".gitignore") or "").split("\n")
    ignore_mine = set((norm(root / ".gitignore") or "").split("\n"))
    for line in ignore_rendered:
        if line.strip() and line not in ignore_mine:
            rep.error(".gitignore lacks template line: %s" % line)


def check_drift(root, answers, rep):
    src = str(answers.get("_src_path", ""))
    if not re.match(r"^(gh:|gl:|https?://|git@|git\+)", src):
        rep.warn("drift check skipped: _src_path '%s' is not a remote template" % src)
        return
    copier = shlex.split(os.environ.get("COPIER", "copier"))
    if shutil.which(copier[0]) is None:
        rep.warn("drift check skipped: Copier is not installed")
        return
    with tempfile.TemporaryDirectory() as tmp:
        work = Path(tmp) / root.resolve().name
        shutil.copytree(root, work, ignore=shutil.ignore_patterns("data"))
        result = subprocess.run(copier + ["recopy", "--defaults", "--overwrite", "--quiet", str(work)],
                                capture_output=True, text=True)
        if result.returncode != 0:
            rep.warn("drift check skipped: template not reachable or recopy failed: %s"
                     % (result.stderr.strip().splitlines() or ["unknown error"])[-1])
            return
        compare_with_render(root, work, rep)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--root", default=str(Path(__file__).resolve().parent.parent))
    parser.add_argument("--branch", default="")
    parser.add_argument("--pr-title", default="")
    parser.add_argument("--meta-only", action="store_true", help="check only --branch and --pr-title")
    parser.add_argument("--drift", action="store_true", help="compare template-owned content with a fresh render")
    parser.add_argument("--compare-to", default="", help=argparse.SUPPRESS)
    args = parser.parse_args(argv)
    root = Path(args.root)
    rep = Report()

    answers = check_answers(root, rep)
    types = allowed_types(answers or {})
    check_branch(args.branch, types, rep)
    check_pr_title(args.pr_title, types, rep)
    if not args.meta_only and answers:
        profile = answers["profile"]
        private = check_identity(root, answers, rep)
        check_files(root, profile, rep)
        check_agents(root, profile, private, bool(answers.get("efficiency_routing")), rep)
        check_content(root, rep)
        if args.compare_to:
            compare_with_render(root, Path(args.compare_to), rep)
        if args.drift:
            check_drift(root, answers, rep)

    for msg in rep.warnings:
        print("WARN:  " + msg)
    for msg in rep.errors:
        print("ERROR: " + msg)
    print("governance check: %d error(s), %d warning(s)" % (len(rep.errors), len(rep.warnings)))
    return 1 if rep.errors else 0


if __name__ == "__main__":
    sys.exit(main())
